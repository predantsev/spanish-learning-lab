{
  "name": "spanish-learning-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Local Spanish (Spain) learning application with a complete A1-A2 course, Ukrainian interface.",
  "engines": {
    "node": "24.22.1",
    "npm": "11.19.1"
  },
  "packageManager": "npm@11.19.1",
  "workspaces": [
    "packages/contracts",
    "packages/domain",
    "apps/server",
    "apps/web"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --project domain --project integration",
    "test:domain": "vitest run --project domain",
    "test:integration": "vitest run --project integration",
    "test:contracts": "node tools/contracts/generate.ts --check && vitest run --project contract",
    "contracts:generate": "node tools/contracts/generate.ts",
    "content:validate": "node tools/content/validate.ts",
    "content:coverage": "node tools/content/coverage.ts",
    "test:e2e": "playwright test",
    "dev": "node tools/dev.ts",
    "build": "vite build --config apps/web/vite.config.ts",
    "release:check": "node tools/release/check.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true
  }
}
