                  "A1-04-L1-T06",
                  "A1-04-L1-T17",
                  "A1-04-L1-T07",
                  "A1-04-L1-T08",
                  "A1-04-L1-T09",
                  "A1-04-L1-T10",
                  "A1-04-L1-T22",
                  "A1-04-L1-T23",
                  "A1-04-L1-T24",
                  "A1-04-L1-T25"
                ]
              },
              {
                "id": "s6",
                "kind": "listening",
                "titleUk": "Послухай: хто що робить",
                "required": false,
                "taskIds": [
                  "A1-04-L1-T30",
                  "A1-04-L1-T31",
                  "A1-04-L1-T32"
                ],
                "clipIds": [
                  "clip.a1-04.daily-actions.oficina",
                  "clip.a1-04.daily-actions.cena"
                ]
              },
              {
                "id": "s7",
                "kind": "summary",
                "titleUk": "Підсумок",
                "required": true,
                "blocks": [
                  {
                    "type": "bullet-list",
                    "language": "uk",
                    "items": [
                      "Форма = основа + закінчення: habl-ar → habl-o.",
                      "Однина: -o, -as, -a. Множина: -amos, -áis, -an.",
                      "Vosotros — зі знаком наголосу: habláis. Usted / ustedes — форми 3-ї особи.",
                      "«Разом із кимось» — con: Ceno con mi familia."
                    ]
                  }
                ]
              }
            ],
            "reviewStatus": "draft"
          }
        }
