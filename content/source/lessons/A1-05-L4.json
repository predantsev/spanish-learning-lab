      ]
    },
    {
      "id": "s3",
      "kind": "independent-practice",
      "titleUk": "Крок 1: самостійно",
      "required": true,
      "taskIds": [
        "A1-05-L4-T03",
        "A1-05-L4-T05",
        "A1-05-L4-T06",
        "A1-05-L4-T14",
