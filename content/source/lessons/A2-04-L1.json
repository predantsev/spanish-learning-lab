  "titleUk": "Простий минулий час: дієслова на -ar",
  "termEs": "pretérito indefinido: verbos en -ar",
  "summaryUk": "Pretérito indefinido розповідає про завершені події в минулому, яке вже відокремлене від «зараз»: ayer, anoche, la semana pasada. Закінчення дієслів на -ar і знак наголосу в hablé, habló.",
  "objectives": [
    "A2-04-O1",
    "A2-04-O8"
  ],
  "cv": [],
  "situations": [
    "routine-study-leisure",
    "time-appointments-transport",
    "food-shopping"
  ],
  "estimatedMinutes": 15,
  "introduces": [
    "indefinido.regular-ar",
    "time.past-markers"
  ],
  "revisits": [
    "present.regular-ar",
    "present.regular-ar.plural",
    "date.days-of-week",
