      "required": true,
      "blocks": [
        {
          "type": "paragraph",
          "language": "uk",
          "text": "Кожне завдання має своє повідомлення. Шукайте звертання, підпис і питання."
        }
      ],
      "taskIds": [
        "A2-08-L2-T02",
