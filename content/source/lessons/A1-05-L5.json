  "titleUk": "Де це? Предмети й місця",
  "termEs": "expresiones de lugar",
  "summaryUk": "Кажемо, де лежить предмет у кімнаті й де місце в місті (encima de, al lado de, cerca de, enfrente de…), і зливаємо de + el в del.",
  "objectives": [
    "A1-05-O5"
  ],
  "cv": [
    "CV-03"
  ],
  "situations": [
    "people-family-home",
    "places-accommodation"
  ],
  "estimatedMinutes": 18,
  "introduces": [
