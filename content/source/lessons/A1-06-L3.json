  "blockId": "A1-06",
  "titleUk": "Що мені потрібно: necesitar",
  "termEs": "el verbo necesitar",
  "summaryUk": "Кажемо, що потрібно (necesito un paraguas) і що треба зробити (necesito comprar pan); не плутаємо потребу з «подобається».",
  "objectives": [
    "A1-06-O3"
  ],
  "situations": [
    "food-shopping",
    "routine-study-leisure"
  ],
  "estimatedMinutes": 12,
  "introduces": [
    "necesitar.noun",
    "necesitar.infinitive"
  ],
  "revisits": [
    "present.regular-ar",
    "present.regular-ar.plural",
    "article.definite-indefinite",
