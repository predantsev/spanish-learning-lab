  "steps": [
    {
      "id": "s1",
      "kind": "explanation",
      "titleUk": "Крок 1. Кому подобається: me, te, le, nos, os, les",
      "required": true,
      "blocks": [
        {
          "type": "paragraph",
          "language": "uk",
          "text": "Gustar будується як українське «мені подобається»: людину позначає займенник перед дієсловом, а те, що подобається, — підмет. Не «yo gusto», а me gusta."
        },
        {
          "type": "table",
          "language": "uk",
          "columns": [
            "особа",
            "займенник",
            "приклад"
          ],
          "rows": [
            [
              "yo → «мені»",
              "me",
              "Me gusta el té."
            ],
            [
              "tú → «тобі»",
              "te",
              "¿Te gusta el café?"
            ],
            [
              "él / ella / usted",
              "le",
              "Le gusta la playa."
            ],
            [
              "nosotros → «нам»",
              "nos",
              "Nos gusta el teatro."
            ],
            [
              "vosotros → «вам» (на «ти»)",
              "os",
              "¿Os gusta el chocolate?"
            ],
            [
              "ellos / ellas / ustedes",
              "les",
              "Les gusta la música."
            ]
          ]
        },
        {
          "type": "paragraph",
          "language": "uk",
          "text": "Le — і «йому», і «їй», і ввічливе «Вам» до однієї людини. Les — «їм» або формальне «вам» до кількох (ustedes)."
        }
      ]
    },
    {
      "id": "s2",
      "kind": "supported-practice",
      "titleUk": "Крок 1: практика зі зразком",
      "required": true,
