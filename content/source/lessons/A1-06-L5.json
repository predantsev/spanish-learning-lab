      "titleUk": "Крок 1: самостійно",
      "required": true,
      "taskIds": [
        "A1-06-L5-T11",
        "A1-06-L5-T03",
        "A1-06-L5-T04",
        "A1-06-L5-T18",
        "A1-06-L5-T14",
        "A1-06-L5-T15",
