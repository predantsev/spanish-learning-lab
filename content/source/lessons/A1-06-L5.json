  "steps": [
    {
      "id": "s1",
      "kind": "explanation",
      "titleUk": "Крок 1. Y, e, pero",
      "required": true,
      "blocks": [
        {
          "type": "paragraph",
          "language": "uk",
          "text": "Y — «і»: з’єднує схожі або послідовні думки. Перед словом на i- або hi- (звук [i]) y змінюється на e: español e inglés, padres e hijos."
        },
        {
          "type": "paragraph",
          "language": "uk",
          "text": "Pero — «але»: протиставлення. Перед pero зазвичай ставимо кому."
        },
        {
          "type": "example",
          "spanish": "Me gusta nadar y correr.",
          "ukrainian": "Мені подобається плавати й бігати."
        },
        {
          "type": "example",
          "spanish": "Hablo francés e inglés.",
          "ukrainian": "Я говорю французькою й англійською."
        },
        {
          "type": "example",
          "spanish": "Me gusta el té, pero no me gusta el café.",
          "ukrainian": "Мені подобається чай, але не подобається кава."
        }
      ]
    },
    {
      "id": "s2",
      "kind": "supported-practice",
      "titleUk": "Крок 1: практика зі зразком",
      "required": true,
      "taskIds": [
        "A1-06-L5-T01",
