          "type": "example",
          "spanish": "Le di un regalo a Ana.",
          "ukrainian": "Я подарував(-ла) Ані подарунок."
        },
        {
          "type": "example",
          "spanish": "Anoche vimos una película.",
          "ukrainian": "Учора ввечері ми дивилися фільм."
        }
      ]
