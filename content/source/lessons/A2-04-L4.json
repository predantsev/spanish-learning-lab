              "oímos"
            ],
            [
              "vosotros / vosotras",
              "leísteis",
              "oísteis"
            ],
            [
              "ellos / ellas / ustedes",
              "leyeron",
              "oyeron"
            ]
          ]
        },
        {
          "type": "example",
          "spanish": "Ayer leí el periódico. Mi padre también lo leyó.",
          "ukrainian": "Учора я прочитав(-ла) газету. Мій тато теж її прочитав."
        },
        {
          "type": "paragraph",
          "language": "uk",
          "text": "Caerse — «падати»: El niño se cayó. Las botellas se cayeron."
        }
