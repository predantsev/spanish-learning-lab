      ]
    },
    {
      "id": "s6",
      "kind": "listening",
      "titleUk": "Слухаємо: що вже зроблено",
      "required": true,
      "blocks": [
        {
          "type": "paragraph",
          "language": "uk",
          "text": "Два короткі голосові повідомлення. Слухайте стільки разів, скільки потрібно; текст можна відкрити як підказку."
        }
      ],
      "taskIds": [
