              "escoges"
            ]
          ]
        },
        {
          "type": "example",
          "spanish": "Salgo de casa a las ocho y cojo el autobús.",
          "ukrainian": "Я виходжу з дому о восьмій і сідаю на автобус."
        },
        {
          "type": "example",
          "spanish": "No conozco Valencia.",
          "ukrainian": "Я не знаю Валенсії."
        }
      ]
    },
    {
      "id": "s2",
      "kind": "supported-practice",
      "titleUk": "Крок 1. Форма yo за зразком",
      "required": true,
      "taskIds": [
        "A2-01-L2-T01",
        "A2-01-L2-T02",
        "A2-01-L2-T11",
        "A2-01-L2-T12",
