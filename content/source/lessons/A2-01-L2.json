  "steps": [
    {
      "id": "s1",
      "kind": "explanation",
      "titleUk": "Форма yo на -go, -zco і -jo",
      "required": true,
      "blocks": [
        {
          "type": "paragraph",
          "language": "uk",
          "text": "У деяких дієсловах неправильна лише форма yo, а інші особи відмінюються регулярно."
        },
        {
          "type": "paragraph",
          "language": "uk",
          "text": "poner, salir, traer, hacer → pongo, salgo, traigo, hago (-go). conocer, conducir, traducir → conozco, conduzco, traduzco (-zco). coger, recoger, escoger → cojo, recojo, escojo: тут змінюється лише написання — перед -o пишемо j, щоб зберегти звук [х]."
        },
        {
          "type": "table",
          "language": "es-ES",
          "columns": [
            "infinitivo",
            "yo",
            "tú"
          ],
          "rows": [
            [
              "poner",
              "pongo",
              "pones"
            ],
            [
              "salir",
              "salgo",
              "sales"
            ],
            [
              "traer",
              "traigo",
              "traes"
            ],
            [
              "hacer",
              "hago",
              "haces"
            ],
            [
              "conocer",
              "conozco",
              "conoces"
            ],
            [
              "conducir",
              "conduzco",
              "conduces"
            ],
            [
              "traducir",
              "traduzco",
              "traduces"
            ],
            [
