  "steps": [
    {
      "id": "s1",
      "kind": "explanation",
      "titleUk": "Частина 1. Питання «так чи ні»",
      "required": true,
      "blocks": [
        {
          "type": "paragraph",
          "language": "uk",
          "text": "Щоб поставити питання «так чи ні», часто досить узяти твердження й додати знаки ¿ ?: Eres de Madrid. → ¿Eres de Madrid? Підмет можна залишити на місці або поставити після дієслова: ¿Ana es profesora? / ¿Es Ana profesora? На слух питання впізнаємо за інтонацією: голос у кінці підвищується."
        },
        {
          "type": "example",
          "spanish": "¿Tienes coche? — Sí. / No.",
          "ukrainian": "У тебе є машина? — Так. / Ні."
        },
        {
          "type": "example",
          "spanish": "¿Hay leche?",
          "ukrainian": "Є молоко?"
        }
      ]
    },
    {
      "id": "s2",
      "kind": "supported-practice",
      "titleUk": "Частина 1. Тренування з підказкою",
      "required": true,
      "taskIds": [
        "A1-03-L6-T01",
