    {
      "id": "s6",
      "kind": "examples",
      "titleUk": "У магазині та кафе",
      "required": true,
      "blocks": [
        {
          "type": "paragraph",
          "language": "uk",
          "text": "Ці фрази вчимо цілими, без розбору граматики всередині."
        },
        {
          "type": "example",
          "spanish": "¿Qué desea? / ¿Qué le pongo?",
          "ukrainian": "Що бажаєте? / Що вам дати?"
        },
        {
          "type": "example",
          "spanish": "¿Me pone un café, por favor?",
          "ukrainian": "Можна мені каву, будь ласка? (типово для бару в Іспанії)"
        },
        {
          "type": "example",
          "spanish": "¿Algo más? — Nada más, gracias.",
          "ukrainian": "Щось іще? — Більше нічого, дякую."
        },
        {
          "type": "example",
          "spanish": "Aquí tiene.",
          "ukrainian": "Ось, будь ласка (коли щось подають)."
        },
        {
          "type": "example",
          "spanish": "¿En efectivo o con tarjeta? — Con tarjeta, por favor.",
          "ukrainian": "Готівкою чи карткою? — Карткою, будь ласка."
        },
        {
          "type": "example",
          "spanish": "La cuenta, por favor.",
          "ukrainian": "Рахунок, будь ласка."
        }
      ]
    },
