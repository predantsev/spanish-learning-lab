          "ukrainian": "його / її / їхній / Ваш собака"
        },
        {
          "type": "example",
          "spanish": "nuestra familia",
          "ukrainian": "наша сім’я"
        },
        {
          "type": "example",
          "spanish": "vuestros hijos",
          "ukrainian": "ваші діти (кільком друзям)"
        },
        {
          "type": "example",
          "spanish": "el gato de Ana",
          "ukrainian": "кіт Ани"
        }
      ]
    },
