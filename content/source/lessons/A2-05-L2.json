    },
    {
      "id": "s3",
      "kind": "examples",
      "titleUk": "Приклади",
      "required": true,
      "blocks": [
        {
          "type": "example",
          "spanish": "Antes mi hermana vivía en Valencia.",
          "ukrainian": "Раніше моя сестра жила у Валенсії."
        },
        {
          "type": "example",
          "spanish": "Antes yo leía mucho por la noche.",
          "ukrainian": "Раніше я багато читав (читала) ввечері."
        },
        {
          "type": "example",
          "spanish": "¿Antes comíais en casa?",
          "ukrainian": "Ви (кілька людей) раніше обідали вдома?"
        },
        {
          "type": "example",
          "spanish": "Antes yo no podía dormir bien.",
          "ukrainian": "Раніше я не міг (не могла) добре спати."
        },
        {
          "type": "example",
          "spanish": "Antes mis padres tenían una tienda.",
          "ukrainian": "Раніше мої батьки мали крамницю."
        },
        {
          "type": "example",
          "spanish": "Antes Luis siempre pedía un café.",
          "ukrainian": "Раніше Луїс завжди замовляв каву."
        },
        {
          "type": "example",
          "spanish": "Antes los niños hacían los deberes por la tarde.",
          "ukrainian": "Раніше діти робили домашнє завдання після обіду."
        },
        {
          "type": "paragraph",
          "language": "uk",
          "text": "Нове слово: los deberes — домашнє завдання (hacer los deberes — робити домашнє завдання)."
        }
      ]
    },
