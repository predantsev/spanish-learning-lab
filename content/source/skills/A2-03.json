        }
      ],
      "reviewStatus": "reviewed"
    },
    {
      "skillId": "perfecto.haber-vs-hay",
      "parentObjectives": [
        "A2-03-O1"
      ],
      "kind": "contrast",
      "modalities": [
        "written-form",
        "context-choice"
      ],
      "titleUk": "Ha comido, а не *hay comido: допоміжне haber і hay",
      "termEs": "haber auxiliar / hay",
      "scope": {
        "forms": [
          "Hay un banco aquí. (є, існує)",
          "Ana ha comido. (допоміжне дієслово)"
        ],
        "noteUk": "Hay — особлива безособова форма того самого дієслова haber; у складеному часі її не вживаємо."
      },
      "firstLesson": "A2-03-L1",
      "prerequisites": [
        "perfecto.haber-forms",
        "hay.existence"
      ],
      "ruleUk": "Hay означає «є, існує»: Hay un banco aquí. У складеному минулому часі вживаємо he, has, ha…: Ana ha comido (не *hay comido).",
      "assessed": true,
      "returns": {
        "practice": [
          "A2-03-L5"
        ],
        "check": [
          "A2-03-C1"
        ],
        "later": [
          "A2-06-L4"
        ]
      },
      "cv": [],
      "situations": [
        "routine-study-leisure"
      ],
      "sources": [
        {
          "sourceId": "S1",
          "section": "9.1.6",
          "note": "A2-03-O1 boundary: teach the compound-tense role explicitly rather than reusing impersonal hay"
        }
      ],
      "bankJustificationUk": "Контраст ha / hay перевіряємо двома способами: 6 завдань на написання (2 з підтримкою, 2 самостійні, 2 відкладені для повторення: 1 відкладене і 1 на перенесення) і 4 на вибір у контексті (2 самостійні, 2 відкладені для повторення: 1 відкладене і 1 на перенесення) — разом 10. Самі форми haber окремо тренує perfecto.haber-forms.",
      "reviewStatus": "reviewed"
    },
