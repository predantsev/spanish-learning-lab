    {
      "skillId": "perfecto.haber-forms",
      "parentObjectives": [
        "A2-03-O1"
      ],
      "kind": "form",
      "modalities": [
        "written-form"
      ],
      "titleUk": "Допоміжне haber: he, has, ha, hemos, habéis, han",
      "termEs": "pretérito perfecto compuesto: presente de haber",
      "scope": {
        "forms": [
          "he",
          "has",
          "ha",
          "hemos",
          "habéis",
          "han"
        ],
        "persons": [
          "1s",
          "2s",
          "3s",
          "1p",
          "2p",
          "3p"
        ],
        "noteUk": "H не читається: ha звучить як прийменник a, he — як сполучник e, але на письмі h обов'язкове. Habéis — форма для vosotros; usted і ustedes уживають ha, han."
      },
      "firstLesson": "A2-03-L1",
      "prerequisites": [],
      "ruleUk": "Pretérito perfecto compuesto утворюємо так: haber у теперішньому часі + дієприкметник: he comido, has comido, ha comido, hemos comido, habéis comido, han comido. Особу показує тільки haber.",
      "assessed": true,
      "returns": {
        "practice": [
          "A2-03-L2",
          "A2-03-L3",
          "A2-03-L5"
        ],
        "check": [
          "A2-03-C1"
        ],
        "later": [
          "A2-04-L7",
          "A2-06-L2",
          "A2-06-L4"
        ]
      },
      "cv": [],
      "situations": [
