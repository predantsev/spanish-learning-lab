              "viví"
            ],
            [
              "tú",
              "comiste",
              "viviste"
            ],
            [
              "él / ella / usted",
              "comió",
              "vivió"
            ],
            [
              "nosotros / nosotras",
              "comimos",
              "vivimos"
            ],
            [
              "vosotros / vosotras",
              "comisteis",
              "vivisteis"
            ],
            [
              "ellos / ellas / ustedes",
              "comieron",
              "vivieron"
            ]
          ]
        },
        {
          "type": "paragraph",
          "language": "uk",
          "text": "Зміни в написанні — лише у формі yo:"
        },
        {
          "type": "table",
          "language": "es-ES",
          "columns": [
            "infinitivo",
            "yo",
            "él / ella"
          ],
          "rows": [
            [
              "sacar",
              "saqué",
              "sacó"
            ],
            [
              "llegar",
              "llegué",
              "llegó"
            ],
            [
              "empezar",
              "empecé",
              "empezó"
            ]
          ]
        },
        {
          "type": "paragraph",
          "language": "uk",
          "text": "Зміни в основі дієслів на -ir і форми з y — лише в 3-й особі однини й множини:"
        },
        {
          "type": "table",
          "language": "es-ES",
          "columns": [
            "infinitivo",
            "él / ella",
            "ellos / ellas"
          ],
          "rows": [
            [
              "pedir",
              "pidió",
              "pidieron"
            ],
            [
              "dormir",
              "durmió",
              "durmieron"
            ],
            [
              "leer",
              "leyó",
              "leyeron"
            ]
          ]
        },
        {
          "type": "paragraph",
          "language": "uk",
          "text": "Особливі основи. Закінчення -e, -iste, -o, -imos, -isteis, -ieron; форми yo і él / ella — без знака наголосу:"
        },
        {
          "type": "table",
          "language": "es-ES",
          "columns": [
            "infinitivo",
            "yo",
            "él / ella"
          ],
          "rows": [
            [
              "tener",
              "tuve",
              "tuvo"
            ],
            [
              "estar",
              "estuve",
              "estuvo"
            ],
            [
              "poder",
              "pude",
              "pudo"
            ],
            [
              "poner",
              "puse",
              "puso"
            ],
            [
              "hacer",
              "hice",
              "hizo"
            ],
            [
              "venir",
              "vine",
              "vino"
            ],
            [
              "querer",
              "quise",
              "quiso"
            ],
            [
              "decir",
              "dije",
              "dijo"
            ],
            [
              "dar",
              "di",
              "dio"
            ],
            [
              "ver",
              "vi",
              "vio"
            ]
          ]
        },
        {
          "type": "paragraph",
          "language": "uk",
          "text": "Ser та ir мають однакові форми; значення показує контекст (a + місце — ir):"
        },
        {
          "type": "table",
          "language": "es-ES",
          "columns": [
            "sujeto",
            "ser / ir"
          ],
          "rows": [
            [
              "yo",
              "fui"
            ],
            [
              "tú",
              "fuiste"
            ],
            [
              "él / ella / usted",
              "fue"
            ],
            [
              "nosotros / nosotras",
              "fuimos"
            ],
            [
              "vosotros / vosotras",
              "fuisteis"
            ],
            [
              "ellos / ellas / ustedes",
              "fueron"
            ]
          ]
        },
        {
          "type": "bullet-list",
          "language": "uk",
          "items": [
            "Hace + проміжок часу — «тому»: Llegué hace dos días.",
            "Perfecto — період, що ще триває (hoy, esta semana), або досвід без дати; простий минулий — період, що закінчився (ayer, la semana pasada).",
            "Події по черзі: primero, después, luego, al final, al día siguiente, por fin."
          ]
        },
