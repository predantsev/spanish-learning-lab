    {
      "id": "material.a2-07.requests-permission",
      "topicId": "A2-07-L2",
      "titleUk": "Прохання й дозвіл: шпаргалка",
      "blocks": [
        {
          "type": "paragraph",
          "language": "uk",
          "text": "Кого ми просимо і хто діятиме — від цього залежить форма."
        },
        {
          "type": "table",
          "language": "uk",
          "columns": [
            "Що потрібно",
            "Конструкція",
            "Приклад"
          ],
          "rows": [
            [
              "попросити когось щось зробити",
              "¿Puedes / Puede + інфінітив?",
              "¿Puedes ayudarme?"
            ],
            [
              "попросити річ",
              "¿Me das / Me pasas / Me dejas…?",
              "¿Me pasas el agua?"
            ],
            [
              "ввічливо замовити чи попросити в установі",
              "Quería + іменник / інфінітив",
              "Quería un billete para Toledo."
            ],
            [
              "запитати дозволу для себе",
              "¿Puedo + інфінітив?",
              "¿Puedo abrir la ventana?"
            ],
            [
              "погодитися",
              "Sí, claro. / Claro que sí. / Vale.",
              "—¿Puedo pasar? —Sí, claro."
            ],
            [
              "відмовити з причиною",
              "Lo siento, es que… / Lo siento, pero…",
              "Lo siento, es que el sábado trabajo."
            ]
          ]
        },
        {
          "type": "practice-link",
          "labelUk": "Потренувати прохання й відповіді",
          "targets": [
            {
              "skillId": "formula.request-puedes",
              "modality": "construction-use"
            },
            {
              "skillId": "formula.request-object",
              "modality": "construction-use"
            },
            {
              "skillId": "formula.request-queria",
              "modality": "construction-use"
            },
            {
              "skillId": "formula.permission-puedo",
              "modality": "construction-use"
            },
            {
              "skillId": "formula.response-refuse-reason",
              "modality": "construction-use"
            },
            {
              "skillId": "contrast.tu-usted-register",
              "modality": "context-choice"
            }
          ],
          "mode": "written",
          "maxItems": 10
        }
      ],
      "linkedTargets": [
        "formula.request-puedes/construction-use",
        "formula.request-object/construction-use",
