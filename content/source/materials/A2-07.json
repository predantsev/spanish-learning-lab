    {
      "id": "material.a2-07.pronoun-attached",
      "topicId": "A2-07-L6",
      "titleUk": "Займенник у наказі",
      "blocks": [
        {
          "type": "paragraph",
          "language": "uk",
          "text": "У ствердному наказі займенник пишемо після дієслова разом із ним. Наголос не переміщується: якщо він стає третім складом від кінця — ставимо знак наголосу."
        },
        {
          "type": "example",
          "spanish": "Compra el pan. → Cómpralo.",
          "ukrainian": "Купи хліб. → Купи його."
        },
        {
          "type": "example",
          "spanish": "Llame a la señora García. → Llámela.",
          "ukrainian": "Зателефонуйте пані Гарсії. → Зателефонуйте їй."
        },
        {
          "type": "example",
          "spanish": "Pon el vaso aquí. → Ponlo aquí.",
          "ukrainian": "Постав склянку тут. → Постав її тут. (без знака: PON-lo)"
        },
        {
          "type": "practice-link",
          "labelUk": "Потренувати займенник у наказі",
          "targets": [
            {
              "skillId": "imperative.pronoun-placement",
              "modality": "construction-use"
            },
            {
              "skillId": "imperative.pronoun-accent",
              "modality": "written-form"
            }
          ],
          "mode": "written",
          "maxItems": 10
