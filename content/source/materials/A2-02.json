    {
      "id": "material.a2-02.comparison",
      "topicId": "A2-02-L6",
      "titleUk": "Таблиці: порівняння",
      "blocks": [
        {
          "type": "table",
          "language": "uk",
          "columns": [
            "що порівнюємо",
            "конструкція",
            "приклад"
          ],
          "rows": [
            [
              "більше / менше",
              "más / menos + прикм. + que",
              "Este piso es más caro que ese."
            ],
            [
              "така сама якість",
              "tan + прикм. / присл. + como",
              "Mi piso es tan grande como el tuyo."
            ],
            [
              "стільки ж (з іменником)",
              "tanto / tanta / tantos / tantas + ім. + como",
              "Tengo tantos libros como tú."
            ],
            [
              "стільки ж (з дієсловом)",
              "дієслово + tanto como",
              "Trabajo tanto como tú."
            ],
            [
              "перед числом",
              "más de / menos de",
              "Cuesta más de veinte euros."
            ]
          ]
        },
        {
          "type": "table",
          "language": "uk",
          "columns": [
            "звичайна форма",
            "порівняння",
            "приклад"
          ],
          "rows": [
            [
              "bueno, bien",
              "mejor, mejores",
              "Este café es mejor que ese."
            ],
            [
              "malo, mal",
              "peor, peores",
              "Este hotel es peor que el otro."
            ],
            [
              "вік: старший",
              "mayor, mayores",
              "Mi hermana es mayor que yo."
            ],
            [
              "вік: молодший",
              "menor, menores",
              "Mi hermano es menor que yo."
            ]
          ]
        },
