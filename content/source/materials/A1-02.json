      "topicId": "A1-02",
      "titleUk": "Іменникова група: артикль, рід, число, прикметник, належність",
      "blocks": [
        {
          "type": "paragraph",
          "language": "uk",
          "text": "Коротка довідка до блоку A1-02."
        },
        {
          "type": "table",
          "language": "uk",
          "columns": [
            "Що",
            "Правило",
            "Приклад"
          ],
          "rows": [
            [
              "рід",
              "-o — зазвичай чоловічий, -a — жіночий; -ción, -dad — жіночий; на -e і приголосну — запам’ятовуємо",
              "el libro, la casa, la ciudad, el coche, la flor"
            ],
            [
              "винятки",
              "el día, el mapa, el problema, el idioma, el sofá; la mano, la foto, la moto, la radio",
              "un día bonito, la mano pequeña"
            ],
            [
              "артиклі",
              "el / la, un / una; у множині los / las, unos / unas",
              "unos amigos, las casas"
            ],
            [
              "el чи un",
              "un — нове, «якийсь»; el — відоме, «саме той»",
              "una mochila… la mochila"
            ],
            [
              "множина",
              "голосна + -s, приголосна + -es, -z → -ces; наголос не переходить",
              "cafés, hoteles, lápices, estaciones, jóvenes"
            ],
            [
              "прикметник",
              "після іменника; -o: 4 форми; -e і приголосна: рід не змінюється",
              "una casa blanca, unos coches grandes"
            ],
            [
              "muy",
              "перед прикметником, не змінюється",
              "muy bonita, muy grandes"
            ],
            [
              "належність",
              "mi, tu, su (+ -s); nuestro, vuestro за родом і числом; річ + de + власник",
              "mis libros, nuestra casa, el libro de Ana"
            ]
          ]
        },
