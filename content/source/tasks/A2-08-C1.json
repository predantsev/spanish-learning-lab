    {
      "id": "A2-08-C1-T01",
      "lessonId": "A2-08-C1",
      "role": "independent",
      "family": "fam.check-gym",
      "mode": "choice",
      "targets": [
        {
          "skillId": "reading.practical-information",
          "modality": "reading-meaning"
        }
      ],
      "prompt": [
        {
          "type": "paragraph",
          "language": "uk",
          "text": "Прочитайте оголошення спортзалу. О котрій у суботу зачиняється спортзал?"
        },
        {
          "type": "paragraph",
          "language": "es-ES",
          "text": "Gimnasio Activo. Horario: de lunes a viernes, de 7:00 a 22:00; sábados, de 9:00 a 14:00. Precio: 35 euros al mes. Clases de yoga: martes y jueves, a las 19:00. Hay que traer una toalla. Prohibido entrar con comida."
        }
      ],
      "input": "options",
      "options": [
        {
          "id": "a",
          "label": "о 22:00",
          "outcomes": {
            "reading.practical-information/reading-meaning": "incorrect"
          },
          "feedbackUk": "О 22:00 — з понеділка по п’ятницю. Sábados, de 9:00 a 14:00."
        },
        {
          "id": "b",
          "label": "о 19:00",
          "outcomes": {
            "reading.practical-information/reading-meaning": "incorrect"
          },
          "feedbackUk": "О 19:00 — заняття йогою у вівторок і четвер."
        },
        {
          "id": "c",
          "label": "о 14:00",
          "outcomes": {
            "reading.practical-information/reading-meaning": "correct"
          }
        }
      ],
      "hints": [
        {
          "kind": "rule",
          "targets": [
            "reading.practical-information/reading-meaning"
          ],
          "blocks": [
            {
              "type": "paragraph",
              "language": "uk",
              "text": "Спершу питання, потім пошук потрібної деталі: дня, години, ціни, місця."
            }
          ]
        },
        {
          "kind": "translation",
          "targets": [],
          "blocks": [
            {
              "type": "paragraph",
              "language": "uk",
              "text": "el gimnasio — спортзал; la toalla — рушник"
            }
          ]
        },
        {
          "kind": "reveal",
          "targets": [
            "reading.practical-information/reading-meaning"
          ],
          "blocks": [
            {
              "type": "paragraph",
              "language": "uk",
              "text": "Правильна відповідь: о 14:00"
            }
          ]
        }
      ],
      "feedback": {
        "correctUk": "Правильно! Ви зрозуміли текст.",
        "incorrectUk": "Ні. Перечитайте текст і знайдіть потрібне місце."
      },
      "reviewStatus": "draft"
    },
    {
      "id": "A2-08-C1-T02",
      "lessonId": "A2-08-C1",
      "role": "independent",
      "family": "fam.check-gym",
      "mode": "choice",
      "targets": [
        {
          "skillId": "reading.required-actions",
          "modality": "reading-meaning"
        }
      ],
      "prompt": [
        {
          "type": "paragraph",
          "language": "uk",
          "text": "Прочитайте оголошення ще раз. Що з цього правда?"
        },
        {
          "type": "paragraph",
          "language": "es-ES",
          "text": "Gimnasio Activo. Horario: de lunes a viernes, de 7:00 a 22:00; sábados, de 9:00 a 14:00. Precio: 35 euros al mes. Clases de yoga: martes y jueves, a las 19:00. Hay que traer una toalla. Prohibido entrar con comida."
        }
      ],
      "input": "options",
      "options": [
        {
          "id": "a",
          "label": "Треба приносити їжу на заняття йогою.",
          "outcomes": {
            "reading.required-actions/reading-meaning": "incorrect"
          },
          "feedbackUk": "Prohibido entrar con comida — з їжею заходити заборонено."
        },
        {
          "id": "b",
          "label": "Треба мати з собою рушник, а заходити з їжею не можна.",
          "outcomes": {
            "reading.required-actions/reading-meaning": "correct"
          }
        },
        {
          "id": "c",
          "label": "Рушник не потрібен, а їжу можна приносити.",
          "outcomes": {
            "reading.required-actions/reading-meaning": "incorrect"
          },
          "feedbackUk": "Hay que traer una toalla — треба принести рушник; prohibido entrar con comida — з їжею заходити заборонено."
        }
      ],
      "hints": [
        {
          "kind": "rule",
          "targets": [
            "reading.required-actions/reading-meaning"
          ],
          "blocks": [
            {
              "type": "paragraph",
              "language": "uk",
              "text": "Шукайте hay que, prohibido, накази й слова порядку."
            }
          ]
        },
        {
          "kind": "translation",
          "targets": [],
          "blocks": [
            {
              "type": "paragraph",
              "language": "uk",
              "text": "el gimnasio — спортзал; la toalla — рушник"
            }
          ]
        },
        {
          "kind": "reveal",
          "targets": [
            "reading.required-actions/reading-meaning"
          ],
          "blocks": [
            {
              "type": "paragraph",
              "language": "uk",
              "text": "Правильна відповідь: Треба мати з собою рушник, а заходити з їжею не можна."
            }
          ]
        }
      ],
      "feedback": {
        "correctUk": "Правильно! Ви зрозуміли текст.",
        "incorrectUk": "Ні. Перечитайте текст і знайдіть потрібне місце."
      },
      "reviewStatus": "draft"
    },
    {
      "id": "A2-08-C1-T03",
      "lessonId": "A2-08-C1",
      "role": "independent",
