      "prompt": [
        {
          "type": "paragraph",
          "language": "uk",
          "text": "Прочитайте розповідь. Чому першого дня автор ходив по музеях?"
        },
        {
          "type": "paragraph",
          "language": "es-ES",
          "text": "El año pasado estuve una semana en Granada. El primer día llovía y hacía frío, así que vi muchos museos. Después hizo sol y subí a la Alhambra. ¡Fue increíble!"
        }
      ],
      "input": "options",
      "options": [
        {
          "id": "a",
          "label": "Бо Альгамбру того дня зачинили.",
          "outcomes": {
            "reading.past-account/reading-meaning": "incorrect"
          },
          "feedbackUk": "Про це в тексті нічого немає. Llovía y hacía frío, así que vi muchos museos."
        },
        {
          "id": "b",
          "label": "Бо було дуже сонячно.",
          "outcomes": {
            "reading.past-account/reading-meaning": "incorrect"
          },
          "feedbackUk": "Сонце було пізніше: después hizo sol."
        },
        {
          "id": "c",
          "label": "Бо йшов дощ і було холодно.",
          "outcomes": {
            "reading.past-account/reading-meaning": "correct"
          }
        }
      ],
      "hints": [
        {
          "kind": "rule",
          "targets": [
            "reading.past-account/reading-meaning"
          ],
          "blocks": [
            {
              "type": "paragraph",
              "language": "uk",
              "text": "Подія — індефінідо, тло і звичка — імперфект; стежте за словами порядку."
            }
          ]
        },
        {
          "kind": "translation",
          "targets": [],
          "blocks": [
            {
              "type": "paragraph",
              "language": "uk",
              "text": "así que — тож; subir a la Alhambra — піднятися до Альгамбри (палац у Гранаді); increíble — неймовірний"
            }
          ]
        },
        {
          "kind": "reveal",
          "targets": [
            "reading.past-account/reading-meaning"
          ],
          "blocks": [
            {
              "type": "paragraph",
              "language": "uk",
              "text": "Правильна відповідь: Бо йшов дощ і було холодно."
            }
          ]
        }
      ],
      "feedback": {
        "correctUk": "Правильно! Ви зрозуміли текст.",
        "incorrectUk": "Ні. Перечитайте текст і знайдіть потрібне місце."
      },
      "reviewStatus": "draft"
    },
