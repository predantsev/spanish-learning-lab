        {
          "type": "paragraph",
          "language": "es-ES",
          "text": "Hola, Teresa: El viernes es la fiesta de despedida de Juan en el bar La Plaza. ¿Vienes? Es una sorpresa: Juan no sabe nada. Confírmame mañana. Un abrazo, Clara"
        }
      ],
      "input": "options",
      "options": [
        {
          "id": "a",
          "label": "Клара пише Терезі: запрошує на прощальну вечірку Хуана.",
          "outcomes": {
            "reading.message-purpose/reading-meaning": "correct"
          }
        },
        {
          "id": "b",
          "label": "Тереза пише Кларі: запрошує на свою вечірку.",
          "outcomes": {
            "reading.message-purpose/reading-meaning": "incorrect"
          },
          "feedbackUk": "Hola, Teresa — звертання до Терези; підпис — Clara."
        },
        {
          "id": "c",
          "label": "Хуан пише Терезі: розповідає про свою вечірку.",
          "outcomes": {
            "reading.message-purpose/reading-meaning": "incorrect"
          },
          "feedbackUk": "Пише Клара (підпис), а для Хуана вечірка — сюрприз."
        }
