    {
      "id": "A2-08-L5-T01",
      "lessonId": "A2-08-L5",
      "role": "supported",
      "family": "fam.clip-cena-javier",
      "mode": "choice",
      "targets": [
        {
          "skillId": "listening.voice-message",
          "modality": "listening-meaning"
        }
      ],
      "prompt": [
        {
          "type": "paragraph",
          "language": "uk",
          "text": "Прослухайте голосове повідомлення. Навіщо телефонує Хав’єр?"
        },
        {
          "type": "paragraph",
          "language": "uk",
          "text": "Підказка: спершу головне — що змінилося щодо вечері."
        }
      ],
      "input": "options",
      "clipIds": [
        "clip.a2-08.cena-javier"
      ],
      "options": [
        {
          "id": "a",
          "label": "Скасувати вечерю в п’ятницю.",
          "outcomes": {
            "listening.voice-message/listening-meaning": "incorrect"
          },
          "feedbackUk": "Вечерю не скасовано: al final… es en el restaurante — вона просто в іншому місці."
        },
        {
          "id": "b",
          "label": "Запросити Олену до себе додому.",
          "outcomes": {
            "listening.voice-message/listening-meaning": "incorrect"
          },
          "feedbackUk": "No es en mi casa — вечеря не в нього вдома."
        },
        {
          "id": "c",
          "label": "Повідомити, що вечеря буде в ресторані, а не в нього вдома.",
          "outcomes": {
            "listening.voice-message/listening-meaning": "correct"
          }
        }
      ],
      "hints": [
        {
          "kind": "rule",
          "targets": [
            "listening.voice-message/listening-meaning"
          ],
          "blocks": [
            {
              "type": "paragraph",
              "language": "uk",
              "text": "Спершу визначте головне: хто телефонує і навіщо. Потім деталі: день, годину, місце, що треба зробити."
            }
          ]
        },
        {
          "kind": "transcript",
          "targets": [
            "listening.voice-message/listening-meaning"
          ],
          "blocks": [
            {
              "type": "paragraph",
              "language": "es-ES",
              "text": "Hola, Elena, soy Javier. Te llamo por la cena del viernes. Al final no es en mi casa: es en el restaurante Mar Azul, en la calle Mayor, número doce. Quedamos a las nueve y media. ¿Puedes confirmarme mañana si vienes? Un beso."
            }
          ]
        },
        {
          "kind": "reveal",
          "targets": [
            "listening.voice-message/listening-meaning"
          ],
          "blocks": [
            {
              "type": "paragraph",
              "language": "uk",
              "text": "Правильна відповідь: Повідомити, що вечеря буде в ресторані, а не в нього вдома."
            }
          ]
        }
      ],
      "feedback": {
        "correctUk": "Правильно! Ви зрозуміли повідомлення.",
        "incorrectUk": "Ні. Прослухайте ще раз; за потреби відкрийте текст запису (це врахується як допомога)."
      },
      "reviewStatus": "draft"
    },
