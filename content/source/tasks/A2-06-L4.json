  "tasks": [
    {
      "id": "A2-06-L4-T01",
      "lessonId": "A2-06-L4",
      "role": "supported",
      "family": "forms",
      "mode": "choice",
      "targets": [
        {
          "skillId": "contrast.past-form-identification",
          "modality": "context-choice"
        }
      ],
      "prompt": [
        {
          "type": "paragraph",
          "language": "uk",
          "text": "Зразок: hacía — imperfecto, hizo — indefinido, ha hecho — perfecto. Яка форма — pretérito indefinido від hacer?"
        }
      ],
      "input": "options",
      "options": [
        {
          "id": "a",
          "label": "hacía",
          "outcomes": {
            "contrast.past-form-identification/context-choice": "incorrect"
          },
          "feedbackUk": "Hacía — імперфект."
        },
        {
          "id": "b",
          "label": "hizo",
          "outcomes": {
            "contrast.past-form-identification/context-choice": "correct"
          }
        },
        {
          "id": "c",
          "label": "ha hecho",
          "outcomes": {
            "contrast.past-form-identification/context-choice": "incorrect"
          },
          "feedbackUk": "Ha hecho — це форма perfecto."
        }
      ],
      "hints": [
        {
          "kind": "rule",
          "targets": [
            "contrast.past-form-identification/context-choice"
          ],
          "blocks": [
            {
              "type": "paragraph",
              "language": "uk",
              "text": "Порівнюйте закінчення й основу: -aba / -ía — imperfecto (hablaba, vivía); наголошені -é, -ó, -í, -ió — indefinido (hablé, habló, viví, vivió); haber + дієприкметник — perfecto (ha hablado, ha vivido). Згадайте й особливі форми ser, ir, ver та особливі дієприкметники. Fue буває і від ser, і від ir — дивіться на зміст."
            }
          ]
        }
      ],
      "feedback": {
        "correctUk": "Правильно.",
        "incorrectUk": "Ні. Подумайте, про який час і яку ситуацію йдеться."
      },
      "reviewStatus": "draft"
    },
